# Google Cloud service account with access to the target spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Google Drive folder for registration files, photos, and payment receipts
GOOGLE_DRIVE_FOLDER_ID=

# Recommended for personal Google Drive: OAuth refresh credentials for your account.
# Alternatively use a Google Workspace Shared Drive and service-account access.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Supabase is the primary store after migrating existing Sheets data.
# Keep DATA_STORE=sheets until the schema is applied and migration is complete.
DATA_STORE=sheets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Admin account and signing secret (use unique strong values)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=

# Fonnte API token and optional admin WhatsApp number, international format
FONNTE_TOKEN=
FONNTE_ADMIN_NUMBER=
FONNTE_WEBHOOK_SECRET=

# Optional n8n AI chat webhook; this URL is public and is used by the browser
VITE_N8N_CHAT_WEBHOOK_URL=

# Public URL, used when composing participant portal links
# For local development, leave blank or use http://127.0.0.1:5173
APP_URL=http://127.0.0.1:5173
